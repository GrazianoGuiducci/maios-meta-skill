{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maios:material-work-continuity:v1",
  "title": "D-ND Material Work Continuity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "owner_surface",
    "owner_state_ref",
    "authority_initial",
    "authority_current",
    "events",
    "active_event_ids",
    "superseded_event_ids",
    "unknowns",
    "current_relation",
    "next_legal_action",
    "reopen_condition",
    "finite_state",
    "previous_digest",
    "state_digest"
  ],
  "properties": {
    "schema": {
      "const": "dnd.material_work_continuity.state.v1"
    },
    "version": {
      "const": 1
    },
    "owner_surface": {
      "type": "string",
      "minLength": 1
    },
    "owner_state_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_initial": {
      "type": "string",
      "minLength": 1
    },
    "authority_current": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "active_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "superseded_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "current_relation": {
      "type": "string"
    },
    "next_legal_action": {
      "type": "string"
    },
    "reopen_condition": {
      "type": "string"
    },
    "finite_state": {
      "enum": [
        "EMPTY_CONTINUITY",
        "CONTINUITY_CAPTURED",
        "CURRENT_RELATION_RECONSTRUCTABLE",
        "INCOMPLETE_SOURCE_RECONSTRUCTION"
      ]
    },
    "previous_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourcePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_class",
        "source_ref",
        "exact_text",
        "source_digest",
        "secret_classified",
        "source_gap_marker",
        "operative_status"
      ],
      "properties": {
        "provenance_class": {
          "enum": [
            "direct_operator",
            "owner_source",
            "operator_submitted_uncertain_authorship"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "exact_text": {
          "type": "string"
        },
        "source_digest": {
          "type": "string"
        },
        "secret_classified": {
          "type": "boolean"
        },
        "source_gap_marker": {
          "type": "string"
        },
        "operative_status": {
          "const": "active"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "secret_classified": {
                "const": true
              }
            },
            "required": [
              "secret_classified"
            ]
          },
          "then": {
            "properties": {
              "exact_text": {
                "const": ""
              },
              "source_digest": {
                "const": ""
              },
              "source_gap_marker": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "source_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_gap_marker": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "secret_classified": {
                "const": false
              },
              "exact_text": {
                "const": ""
              }
            },
            "required": [
              "secret_classified",
              "exact_text"
            ]
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^(?:/|[A-Za-z]:[/\\\\])"
              }
            }
          }
        }
      ]
    },
    "projectionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "derives_from",
        "operative_status"
      ],
      "properties": {
        "projection": {
          "type": "string",
          "minLength": 1
        },
        "derives_from": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "operative_status": {
          "const": "active"
        }
      }
    },
    "movementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_requested",
        "action_performed",
        "evidence_refs",
        "effects_observed",
        "authority_before",
        "authority_after"
      ],
      "properties": {
        "action_requested": {
          "type": "string",
          "minLength": 1
        },
        "action_performed": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "effects_observed": {
          "$ref": "#/$defs/stringList"
        },
        "authority_before": {
          "type": "string",
          "minLength": 1
        },
        "authority_after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retractionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retraction_authority_ref",
        "retracts",
        "scope",
        "effective_relation_change",
        "effects_not_reversed"
      ],
      "properties": {
        "retraction_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "retracts": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "effective_relation_change": {
          "type": "string",
          "minLength": 1
        },
        "effects_not_reversed": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "authorityPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_before",
        "authority_after",
        "owner_receipt_ref"
      ],
      "properties": {
        "authority_before": {
          "type": "string",
          "minLength": 1
        },
        "authority_after": {
          "type": "string",
          "minLength": 1
        },
        "owner_receipt_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknownPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adds",
        "resolves",
        "evidence_refs"
      ],
      "properties": {
        "adds": {
          "$ref": "#/$defs/stringList"
        },
        "resolves": {
          "$ref": "#/$defs/stringList"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolves": {
                "minItems": 1
              }
            },
            "required": [
              "resolves"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "checkpointPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_refs",
        "projection_refs",
        "current_relation",
        "unknowns",
        "next_legal_action",
        "reopen_condition"
      ],
      "properties": {
        "source_event_refs": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "projection_refs": {
          "$ref": "#/$defs/stringList"
        },
        "current_relation": {
          "type": "string",
          "minLength": 1
        },
        "unknowns": {
          "$ref": "#/$defs/stringList"
        },
        "next_legal_action": {
          "type": "string",
          "minLength": 1
        },
        "reopen_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event_id",
        "event_kind",
        "owner_surface",
        "previous_state_digest",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "dnd.material_work_continuity.event.v1"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_kind": {
          "enum": [
            "source_event",
            "assistant_projection",
            "verified_movement",
            "retraction_or_supersession",
            "authority_change",
            "unknown_change",
            "relation_checkpoint"
          ]
        },
        "owner_surface": {
          "type": "string",
          "minLength": 1
        },
        "previous_state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "source_event"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/sourcePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "assistant_projection"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/projectionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "verified_movement"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/movementPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "retraction_or_supersession"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/retractionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "authority_change"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/authorityPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "unknown_change"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/unknownPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "relation_checkpoint"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/checkpointPayload"
              }
            }
          }
        }
      ]
    }
  }
}
